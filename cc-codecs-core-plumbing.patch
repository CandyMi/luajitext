diff --git a/src/Makefile b/src/Makefile
index 0b8c04f7..5a22281c 100644
--- a/src/Makefile
+++ b/src/Makefile
@@ -527,7 +527,7 @@ LJCORE_O= lj_assert.o lj_gc.o lj_err.o lj_char.o lj_bc.o lj_obj.o lj_buf.o \
 	  lj_ctype.o lj_cdata.o lj_cconv.o lj_ccall.o lj_ccallback.o \
 	  lj_carith.o lj_clib.o lj_cparse.o \
 	  lj_lib.o lj_alloc.o lib_aux.o \
-	  $(LJLIB_O) lib_init.o
+	  $(LJLIB_O) lib_init.o yyjson.o lib_ccjson.o lib_ccmsgpack.o
 
 LJVMCORE_O= $(LJVM_O) $(LJCORE_O)
 LJVMCORE_DYNO= $(LJVMCORE_O:.o=_dyn.o)
@@ -734,6 +734,19 @@ $(HOST_O): %.o: %.c
 
 include Makefile.dep
 
+# cc codecs: the module sources live in ../ext, not in src/. Bind the src
+# objects to the ext sources and replicate the generic %.o rule (which
+# produces both the static and the _dyn.o object).
+lib_ccjson.o yyjson.o: %.o: ../ext/%.c
+	$(E) "CC        $@"
+	$(Q)$(TARGET_DYNCC) $(TARGET_ACFLAGS) -I. -c -o $(@:.o=_dyn.o) $<
+	$(Q)$(TARGET_CC) $(TARGET_ACFLAGS) -I. -c -o $@ $<
+
+lib_ccmsgpack.o: ../ext/lib_ccmsgpack.c
+	$(E) "CC        $@"
+	$(Q)$(TARGET_DYNCC) $(TARGET_ACFLAGS) -I. -c -o $(@:.o=_dyn.o) $<
+	$(Q)$(TARGET_CC) $(TARGET_ACFLAGS) -I. -c -o $@ $<
+
 ##############################################################################
 # Target file rules.
 ##############################################################################
